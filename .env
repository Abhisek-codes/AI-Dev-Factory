# The URL to your specific Azure OpenAI / Foundry resource
AZURE_OPENAI_ENDPOINT=https://azureopenai-poc-10.cognitiveservices.azure.com/

# The name you gave your model when you deployed it (e.g., gpt-4.1)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1

# Frontend / API runtime
# FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
PORT=8000
DEBUG=false

# Azure deployment metadata
AZURE_SUBSCRIPTION_ID=0dfc2b8f-9b5d-4835-997b-d82546b59d58
AZURE_RESOURCE_GROUP=CoPaDeploymentSwedon

# Azure Blob Storage (Claim Check Pattern)
# Format: https://<storage-account-name>.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_URL=https://aetherartifacts.blob.core.windows.net
AZURE_STORAGE_CONTAINER_NAME=artifacts
